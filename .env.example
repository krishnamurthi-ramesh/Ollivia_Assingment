# ── AI API Keys (Optional) ────────────────────────────────────────────────────

# Google Gemini API Key (free tier: https://ai.google.dev)
# Enables Gemini 1.5 Flash as the frontier model
GOOGLE_API_KEY=your_gemini_api_key_here

# HuggingFace Token (optional: increases rate limits on Inference API)
# Get it at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Anthropic API Key (optional, paid)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API Key (optional, paid)
OPENAI_API_KEY=your_openai_key_here

# ── Notes ─────────────────────────────────────────────────────────────────────
# Without any API keys, both assistants use HuggingFace Inference API for free.
# The OSS assistant (Qwen2.5-0.5B) and Frontier assistant (Mistral-7B) are
# both accessible without authentication on the free tier.
